{
  "name": "todopop",
  "version": "0.4.9",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @todopop/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test packages/shared/test/*.test.ts",
    "start": "npm run build && npm run start --workspace @todopop/desktop",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "format": "prettier --write apps packages scripts *.json *.md docs/*.md",
    "format:check": "prettier --check apps packages scripts *.json *.md docs/*.md",
    "package:mac": "npm run build && npm run package:mac --workspace @todopop/desktop",
    "test:extension": "node scripts/extension-ui.mjs",
    "test:desktop": "npm run build && node scripts/desktop-acceptance.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
